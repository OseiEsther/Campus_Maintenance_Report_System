# ==========================================
# CampusFix Environment Configuration
# ==========================================

# Supabase Project API URL (Found in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon API Key (Found in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional Node.js build version configuration
NODE_VERSION=20

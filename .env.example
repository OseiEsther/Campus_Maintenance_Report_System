# ==========================================
# CampusFix Environment Configuration
# ==========================================

# Supabase Project API URL (Found in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon API Key (Found in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional Node.js build version configuration
NODE_VERSION=20

# ==========================================
# Testing & Administration (scripts/rls-tests.mjs, scripts/create-admin.mjs)
# Required ONLY when running tests locally or creating initial admin
# NEVER commit these secrets or place them in Render static site settings
# ==========================================
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
#
# Accounts for live multi-role RLS test suite (npm run test:rls):
# TEST_STUDENT_EMAIL=test_student1@st.university.edu.gh
# TEST_STUDENT_PASSWORD=your_test_student1_password
# TEST_STUDENT2_EMAIL=test_student2@st.university.edu.gh
# TEST_STUDENT2_PASSWORD=your_test_student2_password
# TEST_REP_EMAIL=test_rep_pentagon@st.university.edu.gh
# TEST_REP_PASSWORD=your_test_rep_password
# TEST_REP_OTHER_EMAIL=test_rep_republic@st.university.edu.gh
# TEST_REP_OTHER_PASSWORD=your_test_rep_other_password
# TEST_STAFF_EMAIL=test_staff@staff.university.edu.gh
# TEST_STAFF_PASSWORD=your_test_staff_password
# TEST_ADMIN_EMAIL=test_admin@admin.university.edu.gh
# TEST_ADMIN_PASSWORD=your_test_admin_password
